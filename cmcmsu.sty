\newcommand{\cmcmsu@setfont}[3][1]{%
    % #1 - fontscale, #2 - series, #3 - font name
    \typeout{Setting font: scale = '#1', series='#2', font name = '#3'}
    \ifPDFTeX%
        \newcommand{\cmcmsu@setfont@command}{%
            \ifx\relax#2\relax
                cmcmsu@tex@#3%
            \else
                cmcmsu@tex@#2@#3%
            \fi
        }
        \@ifundefined{\cmcmsu@setfont@command}{%
            \PackageError{cmcmsu.sty}{%
                Unknown font or font
                set '#3' in TeX mode}{}
        }{
            \typeout{Run command '\cmcmsu@setfont@command'}
            \expandafter\csname\cmcmsu@setfont@command\endcsname%
        }
    \else
        \newcommand{\cmcmsu@setfont@command}{%
            \ifx\relax#2\relax
                cmcmsu@xetex@#3%
            \else
                cmcmsu@xetex@#2@#3%
            \fi
        }
        \@ifundefined{\cmcmsu@setfont@command}{%
            \PackageError{cmcmsu.sty}{%
                Unknown font or font
                set '#3' in XeTeX/LuaTeX mode}{}
        }{
            \typeout{Run command '\cmcmsu@setfont@command{#1}'}
            \expandafter\csname\cmcmsu@setfont@command\endcsname{#1}%
        }
    \fi
    \let\cmcmsu@setfont@command\relax
}

