{algorithm2e}
\newcommand{\cmcmsu@SetAlgorithms}{
    \RequirePackage{algorithm2e}
    %%% ============================================================
    %%% Оформление algorithm2e в стиле lstpseudocode (Dracula Pro Alucard)
    %%% ============================================================
    \providecolor{ListingRule}{HTML}{D5D5D5}
    \providecolor{ListingNumbers}{HTML}{4F4F4F}
    \providecolor{ListingText}{HTML}{1F1F1F}
    \providecolor{ListingBackground}{HTML}{F5F5F5}
    \providecolor{ListingEmph}{HTML}{A3144D}
    \providecolor{ListingComment}{HTML}{635D97}
    \providecolor{ListingString}{HTML}{846E15}
    \providecolor{ListingBuiltin}{HTML}{A34D14}
    \providecolor{ListingType}{HTML}{644AC9}
    \providecolor{ListingConstant}{HTML}{036A96}
    \providecolor{ListingFunction}{HTML}{14710A}
    % --- Шрифты и цвета ---
    \SetAlFnt{\fontsize{12pt}{14pt}\selectfont\ttfamily\color{ListingText}}
    %%% NB: ##1 — потому что мы внутри \newcommand{\cmcmsu@SetAlgorithms}
    \newcommand{\cmcAlgoKw}[1]{%
        \textnormal{\fontsize{12pt}{14pt}\selectfont\ttfamily\bfseries\color{ListingEmph}##1}}
    \SetKwSty{cmcAlgoKw}
    \newcommand{\cmcAlgoArg}[1]{%
        \textnormal{\fontsize{12pt}{14pt}\selectfont\ttfamily\color{ListingText}##1}}
    \SetArgSty{cmcAlgoArg}
    \newcommand{\cmcAlgoFunc}[1]{%
        \textnormal{\fontsize{12pt}{14pt}\selectfont\ttfamily\color{ListingFunction}##1}}
    \SetFuncSty{cmcAlgoFunc}
    \SetProcNameSty{cmcAlgoFunc}
    \SetFuncArgSty{cmcAlgoArg}
    \SetProcArgSty{cmcAlgoArg}
    \SetDataSty{cmcAlgoArg}
    \newcommand{\cmcAlgoComment}[1]{%
        \textnormal{\fontsize{12pt}{14pt}\selectfont\ttfamily\color{ListingComment}##1}}
    \SetCommentSty{cmcAlgoComment}
    \newcommand{\cmcAlgoNl}[1]{%
        \textnormal{\fontsize{12pt}{14pt}\selectfont\color{ListingNumbers}##1}}
    \SetNlSty{cmcAlgoNl}{}{}
    % --- Input / Output (чтобы \KwInput и \KwOutput были определены) ---
    \SetKwInput{KwInput}{\translate{Input}}
    \SetKwInput{KwOutput}{\translate{Output}}
    % --- Геометрия и линии ---
    \setlength{\algomargin}{1.5em}
    \SetNlSkip{8pt}
    \SetAlgoInsideSkip{smallskip}
    \SetInd{0.5em}{1em}
    \DontPrintSemicolon
    \SetAlgoLined
    % --- Подпись: «Алгоритм — Название» без номера ---
    \SetAlgoCaptionSeparator{~\textemdash~}
    \long\def\algocf@captiontext##1##2{%
        \algorithmcfname\algocf@capseparator##2%
    }

    % --- Горизонтальные линии ruled — цвет ListingRule ---

    \renewcommand{\@algocf@pre@ruled}{%
        \vspace{0.4\baselineskip}%
        {\color{ListingRule}\hrule height 0.8pt}%
        \kern3pt%
    }
    \renewcommand{\@algocf@post@ruled}{%
        \kern3pt%
        {\color{ListingRule}\hrule height 0.8pt}%
        \vspace{0.4\baselineskip}%
    }
    \SetAlgorithmName{%
        \translate{Algorithm}}{%
        \translate{Algorithm}}{%
        \translate{List of Algorithms}}%

}

